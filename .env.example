# RFC Audit Agent 环境变量配置模板
CONTROL_PLANE_URL=http://localhost:8787
COMPUTE_AUTH_TOKEN=
WORKER_ID=rfc-audit-worker-01

# 轮询时钟
POLL_INTERVAL_EMPTY=15
COOLDOWN_AFTER_TASK=10

# 大模型配置 (支持任意兼容 OpenAI API 的端点，留空时使用内置规则引擎)
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MAX_OUTPUT_TOKENS=20000
MAX_NODE_RETRIES=3

# 沙箱与安全参数
SANDBOX_TIMEOUT_SEC=60
AUDIT_LOG_FILE=/app/logs/audit.jsonl
GIT_SSH_KEY_FILE=/run/secrets/git-ssh/id_ed25519
GIT_SSH_KNOWN_HOSTS_FILE=/run/secrets/git-ssh/known_hosts
