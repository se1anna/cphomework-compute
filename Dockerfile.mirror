# Temporary build-only mirror variant of the supplied CP.zip Dockerfile.
# It preserves the supplied image, packages, entrypoint, and security model;
# only Ubuntu package mirrors are changed for this host's network path.
FROM ubuntu:22.04
LABEL maintainer="RFC Audit Board <audit@example.com>"
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN groupadd -g 1000 agentuser && useradd -u 1000 -g agentuser -m -s /bin/bash agentuser
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev build-essential gcc g++ clang make cmake git openssh-client cargo rustc ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN mkdir -p /app/workspace /app/cache/venvs /app/cache/pip-cache /app/cache/cargo-cache && \
    chown -R agentuser:agentuser /app && chmod 750 /app/workspace /app/cache
COPY requirements.txt /app/
RUN pip3 install --no-cache-dir \
    -i https://pypi.mirrors.ustc.edu.cn/simple \
    -r /app/requirements.txt
COPY --chown=agentuser:agentuser . /app/
ENV PIP_CACHE_DIR=/app/cache/pip-cache CARGO_HOME=/app/cache/cargo-cache HOME=/home/agentuser
USER agentuser
CMD ["python3", "main.py"]
